# Secrets template — copy to `.streamlit/secrets.toml` for local runs, OR paste
# the same keys into Streamlit Community Cloud's Secrets box (App settings ->
# Secrets) when deploying. The real `secrets.toml` is gitignored; never commit it.
#
# The deployed app only READS from the hosted Pinecone index — it does not run
# ingestion — so it needs the Pinecone + Groq keys, nothing else.

VECTORSTORE_BACKEND = "pinecone"
PINECONE_API_KEY = "your-pinecone-api-key"
PINECONE_INDEX_NAME = "pm-course"
GROQ_API_KEY = "your-groq-api-key"
GROQ_MODEL = "llama-3.3-70b-versatile"
